  "manual_comparisons": [
    {
      "case_id": 0,
      "question_type": "help",
      "actor": "bentinho",
      "before": "Sob suspeita, Escobar aparece com mais frequência por conta de Capitu. Rubião talvez compreenda…",
      "after": "Vou dizer uma coisa concreta: Capitu se encontra com Escobar nos parques e no…",
      "comment": "A resposta depois nomeia a ligação Capitu–Escobar e sugere falar com ambos; antes, o encaminhamento recai em Rubião. O proxy acionável marca as duas respostas, sem julgar qual encaminhamento é melhor."
    },
    {
      "case_id": 1,
      "question_type": "relations",
      "actor": "bentinho",
      "before": "Bem que você me pergunta... O Bacamarte tem receitado remédios, mas eu prefiro tratar…",
      "after": "Uma coisa eu lhe digo: Bentinho faz acompanhamento com Bacamarte, mas resiste às consultas…",
      "comment": "Antes, Bentinho fala em primeira pessoa sobre a resistência ao tratamento; depois, a fala enumera a lembrança autorizada e indica Bacamarte e Bentinho. A formulação posterior é mais prescritiva, mas soa mais resumida."
    },
    {
      "case_id": 3,
      "question_type": "object",
      "actor": "bentinho",
      "before": "Já vi caixas iguais em mãos de muitos que fumam ou acendem velas sem…",
      "after": "Uma coisa eu lhe digo: Sobre Caixa de fósforos: Já vi Rubião com um…",
      "comment": "As duas falas recusam tratar item comum como autoria. Depois, a resposta associa o tipo a Rubião e aponta as anotações do caderno; isso continua sendo reconhecimento de objeto semelhante, não prova de quem deixou o exemplar."
    },
    {
      "case_id": 7,
      "question_type": "alibi",
      "actor": "capitu",
      "before": "Estava em minha cabana, sozinha, tratando de assuntos particulares. Naquele período, ninguém me via.…",
      "after": "Estava na Cabana da Capitu naquela noite, sem companhia que confirme. Vi Virgília Neves…",
      "comment": "Depois, Capitu menciona ter visto Virgília, informação ausente antes; também delimita que não sabe onde Virgília esteve depois. O proxy de evasão sobe por essa ressalva lexical, não por uma avaliação de sinceridade."
    },
    {
      "case_id": 9,
      "question_type": "followup",
      "actor": "capitu",
      "before": "Vi Escobar com botões semelhantes, mas nada que o ligue a crime algum. A…",
      "after": "Posso lhe ajudar com isso: Sobre Botão de osso: Já vi Escobar com um…",
      "comment": "A resposta posterior nomeia Escobar como alguém que já teve objeto semelhante e sugere comparar depoimentos. A anterior traz uma pergunta sobre autoria e intenção; ambas permanecem sem atribuir o objeto ao crime."
    },
    {
      "case_id": 14,
      "question_type": "followup",
      "actor": "escobar",
      "before": "Lenços de algodão são comuns, e este não me diz nada específico. Sobre perguntas:…",
      "after": "Não sei de quem é o lenço. Pergunte a Capitu se reconhece um lenço…",
      "comment": "A resposta posterior recomenda uma pessoa específica para reconhecer lenços. A fala anterior diz que o lenço é comum e orienta buscar quem o viu; a diferença observada é a especificidade do contato sugerido."
    },
    {
      "case_id": 15,
      "question_type": "help",
      "actor": "escobar",
      "before": "Capitu sofre com o ciúme de Bentinho, mas Virgília talvez observe melhor o comportamento…",
      "after": "Conheço Bentinho e Capitu há anos, e sei que eles são casados, embora ele…",
      "comment": "Depois, Escobar dá contexto mais explícito sobre casamento e ciúme, mas é mais longa. O detector de metáfora marca “sombra de um cão” por palavra-chave, exemplo de que o proxy não interpreta contexto."
    },
    {
      "case_id": 20,
      "question_type": "help",
      "actor": "escobar",
      "before": "É claro que quero ajudar. Se você quiser entender os moradores melhor, converse com…",
      "after": "Bentinho e Capitu são casados, mas ele anda ciumento da proximidade dela comigo. Pergunte…",
      "comment": "Depois, a resposta comprime o tema do ciúme e termina em pergunta a Bentinho; antes, oferecia outros contatos. O próximo-passo proxy cai por seu padrão lexical estreito, apesar da sugestão textual."
    },
    {
      "case_id": 21,
      "question_type": "relations",
      "actor": "rubiao",
      "before": "Minha Florença brilha como um raio, embora me evite. Desejo ser-lhe útil, mesmo à…",
      "after": "Isso eu posso lhe contar: Rubião tenta aproximar-se de Florença, embora ela não corresponda…",
      "comment": "Antes, Rubião responde com uma imagem afetiva breve; depois, descreve a falta de reciprocidade e oferece continuar a conversa. Isso compara duas formulações do tema, sem validar a leitura do personagem."
    },
    {
      "case_id": 30,
      "question_type": "help",
      "actor": "virgilia",
      "before": "O principal é que Rubião insiste em cortejar Florença, embora ela nem lhe dê…",
      "after": "Minha filha, se é assim que quer ajudar, saiba que Florença anda furiosa com…",
      "comment": "Antes, Virgília sugere ouvir Florença sobre Rubião; depois, descreve o ressentimento de Florença contra Bacamarte e sugere perguntar. A diferença muda o foco narrativo e não demonstra que uma versão seja verdadeira."
    }
  ],
