# Substitua pelos IDs da sua VPC e de sub-redes públicas em zonas distintas.
aws_region        = "us-east-1"
vpc_id            = "vpc-REPLACE"
public_subnet_ids = ["subnet-REPLACE-A", "subnet-REPLACE-B"]
availability_zone = "us-east-1a"
create_github_oidc_provider = false
# Preencha OWNER_ID e REPO_ID reais. Se o repositório usa subject legado,
# informe explicitamente "repo:Gusreis7/MemoriasLicantropicasGame".
github_oidc_subject_prefix = "repo:Gusreis7@OWNER_ID/MemoriasLicantropicasGame@REPO_ID"
