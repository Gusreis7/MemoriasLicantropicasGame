{
    admin off
    servers {
        protocols h1 h2
    }
}

memoriaslicantropicasgame.gustavodreis.dev.br {
    reverse_proxy game:8080 {
        header_up X-Forwarded-For {remote_host}
        transport http {
            response_header_timeout 150s
        }
    }
}

# Saúde local independente da emissão ACME e do DNS externo.
http://127.0.0.1:8081 {
    reverse_proxy game:8080
}
