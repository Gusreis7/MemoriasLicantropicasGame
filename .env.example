# Redis local. No Compose, a API usa o hostname interno redis.
REDIS_URL=redis://localhost:7080/0
REDIS_PREFIX=ml:v1

# Qwen3 32B no Bedrock Mantle. Deixe a chave vazia até configurar a conta.
AWS_REGION=us-east-1
# API executada no host pode usar o cache do login AWS CLI deste perfil.
# Inicie o Docker com `make setup`; ele aplica o perfil AWS quando configurado.
AWS_PROFILE=terraform
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL=qwen.qwen3-32b
# Vazio deriva https://bedrock-mantle.{AWS_REGION}.api.aws/v1
BEDROCK_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
LLM_HISTORY_LIMIT=20
# Estimativa USD de tabela; só aplicada ao modelo/região declarados. Sem créditos/impostos.
LLM_PRICING_MODEL=qwen.qwen3-32b
LLM_PRICING_REGION=us-east-1
LLM_INPUT_USD_PER_MILLION=0.15
LLM_OUTPUT_USD_PER_MILLION=0.60
LLM_PRICING_SOURCE=https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonBedrock/current/us-east-1/index.json
LLM_PRICING_CHECKED_AT=2026-11-01
# Produção usa instance profile; o Compose de produção define estas opções.
AWS_USE_DEFAULT_CREDENTIALS=false
API_DOCS_ENABLED=true
ALLOWED_HOSTS=*
SOCIAL_ENABLED=true
SOCIAL_POLL_SECONDS=1

# Admin: configurar senha local forte. Sem senha, login é desabilitado.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Alternativa: arquivo montado, sem senha em variáveis de ambiente.
ADMIN_PASSWORD_FILE=
ADMIN_SESSION_SECONDS=28800
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_ORIGINS=http://localhost:7078,http://127.0.0.1:7078
